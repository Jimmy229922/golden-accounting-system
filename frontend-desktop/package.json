{
  "name": "accounting-system-desktop",
  "version": "10.1.4",
  "description": "Professional Accounting System",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node ../scripts/sync-workspace-version.js",
    "prebuild": "node ../scripts/sync-workspace-version.js",
    "start": "electron .",
    "build": "electron-builder --publish never",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "check-backend": "node -e \"require('./src/main/backendClient').checkBackendHealth().then((r)=>console.log(JSON.stringify(r,null,2)))\""
  },
  "build": {
    "appId": "com.accountingsystem.app",
    "productName": "Accounting System",
    "afterPack": "build/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "Jimmy229922",
      "repo": "golden-accounting-system"
    },
    "win": {
      "target": "nsis",
      "icon": "src/main/assets/icon.ico"
    },
    "nsis": {
      "installerIcon": "src/main/assets/icon.ico",
      "uninstallerIcon": "src/main/assets/icon.ico",
      "installerHeaderIcon": "src/main/assets/icon.ico",
      "include": "build/installer.nsh",
      "differentialPackage": true,
      "artifactName": "Accounting-System-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/accounting-system-monorepo",
      "!**/node_modules/accounting-system-monorepo/**"
    ]
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.0.2",
    "electron": "39.2.7",
    "electron-builder": "^26.0.12",
    "javascript-obfuscator": "^5.9.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1"
  }
}
